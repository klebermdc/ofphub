# =====================================================
# TEMPLATE DE SECRETS - Orlando Fast Pass
# Configure estes valores no novo projeto Supabase
# =====================================================

# SUPABASE (configurados automaticamente pelo Lovable)
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=[SUA_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUA_SERVICE_ROLE_KEY]
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
SUPABASE_PUBLISHABLE_KEY=[SUA_PUBLISHABLE_KEY]

# LOVABLE
LOVABLE_API_KEY=[SUA_LOVABLE_API_KEY]

# GOOGLE SHEETS INTEGRATION
# Conta de serviço do Google para acessar planilhas
# Valor: JSON da service account do Google Cloud
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# NOTION INTEGRATION
# API Key da integração com Notion
NOTION_API_KEY=secret_...

# BANCO INTER (API Bancária)
INTER_CLIENT_ID=[SEU_CLIENT_ID]
INTER_CLIENT_SECRET=[SEU_CLIENT_SECRET]
INTER_CERTIFICATE=[CERTIFICADO_BASE64]
INTER_CERTIFICATE_KEY=[CHAVE_CERTIFICADO_BASE64]

# NFS-E SÃO PAULO (Emissão de Notas Fiscais)
NFSE_SP_CNPJ=[SEU_CNPJ]
NFSE_SP_CCM=[SEU_CCM]
NFSE_SP_CERTIFICATE=[CERTIFICADO_DIGITAL_BASE64]
NFSE_SP_CERTIFICATE_PASSWORD=[SENHA_CERTIFICADO]

# =====================================================
# COMO CONFIGURAR NO SUPABASE
# =====================================================
# 1. Acesse o Supabase Dashboard
# 2. Vá em Project Settings > Edge Functions
# 3. Clique em "Secrets"
# 4. Adicione cada secret com seu respectivo valor
